{
  "name": "dsh-office-bundle",
  "version": "0.2.2-rc.1+rev.1",
  "description": "组合结构化文档、文档视图、侧边栏控制工具和讨论工作台，统一安装与启停。",
  "repository": {
    "type": "git",
    "url": "https://github.com/irvingzhang0512/dsh-office-bundle.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "members.lock.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.21.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts"
  },
  "dependencies": {
    "dsh-structured-document": "git+https://github.com/irvingzhang0512/dsh-structured-document.git#9408d04212b54fc95b3fe53f7671fe926c4e0a59",
    "dsh-structured-document-view": "git+https://github.com/irvingzhang0512/dsh-structured-document-view.git#66a7445d60f26c358ba0066bc7858083540352a4",
    "dsh-better-sidebar-controller": "git+https://github.com/irvingzhang0512/dsh-better-sidebar-controller.git#a84fda9c3d87cf3df8cd5e6474b45f0fbd4c4729",
    "dsh-discussion-workbench": "git+https://github.com/irvingzhang0512/dsh-discussion-workbench.git#399591ef5b4ddaa9b0c105e322efa65490296d6f"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "dsh-better-sidebar": "0.28.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.23.5",
    "vitest": "4.1.12",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
