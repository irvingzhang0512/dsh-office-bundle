{
  "name": "dsh-office-bundle",
  "version": "0.2.1-rc.3+rev.1",
  "description": "组合结构化文档、文档视图、侧边栏控制工具和讨论工作台，统一安装与启停。",
  "repository": {
    "type": "git",
    "url": "https://github.com/irvingzhang0512/dsh-office-bundle.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "members.lock.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.21.0",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts"
  },
  "dependencies": {
    "dsh-structured-document": "git+https://github.com/irvingzhang0512/dsh-structured-document.git#84d586776a553baa7f1b7e34cbc6cb552c042991",
    "dsh-structured-document-view": "git+https://github.com/irvingzhang0512/dsh-structured-document-view.git#d0cc899b208266cf7aa1562cb2c792d95d0854ee",
    "dsh-better-sidebar-controller": "git+https://github.com/irvingzhang0512/dsh-better-sidebar-controller.git#34583638dd2bdbf45e92f32433768d8318ba2bc2",
    "dsh-discussion-workbench": "git+https://github.com/irvingzhang0512/dsh-discussion-workbench.git#ff2df19c4318af221ba0943543acbb410d74a47e"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "dsh-better-sidebar": "0.28.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.23.1",
    "vitest": "4.1.12",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
